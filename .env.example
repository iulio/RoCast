# Copy to .env in the repository root. Leave credentials blank for offline runs.

# ENTSO-E Transparency Platform token. Required for the live backtest.
ROCAST_ENTSOE_API_KEY=

# EUMETSAT Data Store credentials for external EUMDAC downloads.
# RoCast reads downloaded SEVIRI files via --seviri-dir.
ROCAST_EUMETSAT_KEY=
ROCAST_EUMETSAT_SECRET=

# NVIDIA NGC key for NIM deployment tools. Export it when running those tools.
# The optional RoCast NIM client reads the same key under ROCAST_NGC_API_KEY.
NGC_API_KEY=
ROCAST_NGC_API_KEY=

# Suggested paths for local download scripts. RoCast does not read these variables.
# The hero generator uses data/ for caches and assets/ for the published image.
ROCAST_DATA_DIR=data
ROCAST_ASSETS_DIR=assets
